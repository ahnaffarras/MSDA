# ── App ──────────────────────────────────────────────
APP_ENV=development
PORT=8080

# ── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb://msda:msda123@mongo:27017/msda?authSource=admin
MONGODB_DB=msda

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379

