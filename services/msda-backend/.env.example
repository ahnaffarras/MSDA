# ── App ──────────────────────────────────────────────
APP_ENV=development
PORT=8080

# ── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb://msda:GANTI_PASSWORD_MONGO@mongo:27017/msda?authSource=admin
MONGODB_DB=msda

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Secret bersama ────────────────────────────────────
# Buat tiap nilai dengan:  openssl rand -hex 32
# Dengan APP_ENV=production backend MENOLAK start bila kosong, terlalu
# pendek (<32 karakter), atau masih berisi nilai contoh. Kedua token harus beda.

# Dikirim n8n pada header X-MSDA-Token saat memanggil POST /api/v1/webhooks/n8n
MSDA_WEBHOOK_TOKEN=

# Dikirim server dashboard pada header X-Internal-Token. Tanpa ini semua
# endpoint /api/v1/* (kecuali webhook & health) menjawab 401/503.
MSDA_INTERNAL_TOKEN=

# ── CORS (opsional) ──────────────────────────────────
# Browser tidak memanggil backend langsung (lewat proxy dashboard), jadi
# biasanya dibiarkan kosong = tidak ada header CORS.
ALLOWED_ORIGINS=
