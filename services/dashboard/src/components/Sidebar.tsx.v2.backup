'use client'

import { useState } from 'react'
import Link from 'next/link'
import { usePathname } from 'next/navigation'

export default function Sidebar() {
  const pathname = usePathname()
  const [labsOpen, setLabsOpen] = useState(true)
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false)
  const [isCollapsed, setIsCollapsed] = useState(false)

  const isActive = (path: string) => pathname === path

  return (
    <>
      {/* Mobile Menu Button */}
      <button
        onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
        className="lg:hidden fixed top-4 left-4 z-50 p-2 bg-[#0f1419] border border-[#1f2937] rounded-lg text-white"
      >
        <svg className="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          {mobileMenuOpen ? (
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
          ) : (
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 6h16M4 12h16M4 18h16" />
          )}
        </svg>
      </button>

      {/* Overlay for mobile */}
      {mobileMenuOpen && (
        <div
          className="lg:hidden fixed inset-0 bg-black/50 z-40"
          onClick={() => setMobileMenuOpen(false)}
        />
      )}

      {/* Sidebar */}
      <aside className={`
        fixed lg:sticky top-0 h-screen
        ${isCollapsed ? 'w-20' : 'w-64'} bg-[#0f1419] border-r border-[#1f2937] flex flex-col
        transition-all duration-300 z-40
        ${mobileMenuOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'}
      `}>
        {/* Header */}
        <div className="px-6 py-6 border-b border-[#1f2937]">
          <div className={`flex items-center ${isCollapsed ? 'justify-center' : 'gap-3'}`}>
            <div className="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg className="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            {!isCollapsed && (
              <div>
                <h1 className="text-white font-semibold text-lg tracking-tight">MSDA</h1>
                <p className="text-[#6b7280] text-xs">Lab Monitor</p>
              </div>
            )}
          </div>
        </div>

        {/* Toggle Button */}
        <button
          onClick={() => setIsCollapsed(!isCollapsed)}
          className="hidden lg:flex absolute -right-3 top-24 w-6 h-6 bg-[#1f2937] hover:bg-[#374151] border border-[#374151] rounded-full items-center justify-center text-white transition-colors z-50"
          title={isCollapsed ? 'Expand sidebar' : 'Collapse sidebar'}
        >
          <svg 
            className={`w-3 h-3 transition-transform ${isCollapsed ? 'rotate-180' : ''}`}
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor"
          >
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        {/* Navigation */}
        <nav className="flex-1 px-4 py-6 overflow-y-auto">
          <div className="space-y-1">
            {/* Dashboard */}
            <Link 
              href="/"
              onClick={() => setMobileMenuOpen(false)}
              className={`flex items-center ${isCollapsed ? 'justify-center' : 'gap-3'} px-3 py-2.5 rounded-lg transition-all ${
                isActive('/') 
                  ? 'bg-blue-500/10 text-blue-400' 
                  : 'text-[#9ca3af] hover:text-white hover:bg-[#1f2937]'
              }`}
              title={isCollapsed ? 'Dashboard' : ''}
            >
              <svg className="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              {!isCollapsed && <span className="font-medium text-sm">Dashboard</span>}
            </Link>

            {/* Lab Komputer */}
            <div>
              <button
                onClick={() => !isCollapsed && setLabsOpen(!labsOpen)}
                className={`w-full flex items-center ${isCollapsed ? 'justify-center' : 'justify-between gap-3'} px-3 py-2.5 rounded-lg transition-all text-[#9ca3af] hover:text-white hover:bg-[#1f2937]`}
                title={isCollapsed ? 'Lab Komputer' : ''}
              >
                <div className={`flex items-center ${isCollapsed ? '' : 'gap-3'}`}>
                  <svg className="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  {!isCollapsed && <span className="font-medium text-sm">Lab Komputer</span>}
                </div>
                {!isCollapsed && (
                  <svg className={`w-4 h-4 transition-transform ${labsOpen ? 'rotate-90' : ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
                  </svg>
                )}
              </button>
              {labsOpen && !isCollapsed && (
                <div className="ml-8 mt-1 space-y-1 border-l-2 border-[#1f2937] pl-3">
                  <Link 
                    href="/labs/all"
                    onClick={() => setMobileMenuOpen(false)}
                    className={`flex items-center gap-2 px-3 py-2 rounded-lg transition-all text-sm ${
                      isActive('/labs/all')
                        ? 'text-white bg-[#1f2937]'
                        : 'text-[#6b7280] hover:text-white hover:bg-[#1f2937]'
                    }`}
                  >
                    Semua Lab
                  </Link>
                </div>
              )}
            </div>

            <div className="h-px bg-[#1f2937] my-4"></div>

            {/* Settings - Lab Configuration */}
            <Link 
              href="/settings"
              onClick={() => setMobileMenuOpen(false)}
              className={`flex items-center ${isCollapsed ? 'justify-center' : 'gap-3'} px-3 py-2.5 rounded-lg transition-all ${
                isActive('/settings')
                  ? 'bg-indigo-500/10 text-indigo-400'
                  : 'text-[#9ca3af] hover:text-white hover:bg-[#1f2937]'
              }`}
              title={isCollapsed ? 'Lab Configuration' : ''}
            >
              <svg className="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {!isCollapsed && <span className="font-medium text-sm">Lab Configuration</span>}
            </Link>

            <div className="h-px bg-[#1f2937] my-4"></div>

            {/* Blacklist DNS */}
            <Link 
              href="/blacklist"
              onClick={() => setMobileMenuOpen(false)}
              className={`flex items-center ${isCollapsed ? 'justify-center' : 'gap-3'} px-3 py-2.5 rounded-lg transition-all ${
                isActive('/blacklist')
                  ? 'bg-amber-500/10 text-amber-400'
                  : 'text-[#9ca3af] hover:text-white hover:bg-[#1f2937]'
              }`}
              title={isCollapsed ? 'Blacklist DNS' : ''}
            >
              <svg className="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
              </svg>
              {!isCollapsed && <span className="font-medium text-sm">Blacklist DNS</span>}
            </Link>

            {/* DNS Info */}
            <Link 
              href="/dns-info"
              onClick={() => setMobileMenuOpen(false)}
              className={`flex items-center ${isCollapsed ? 'justify-center' : 'gap-3'} px-3 py-2.5 rounded-lg transition-all ${
                isActive('/dns-info')
                  ? 'bg-purple-500/10 text-purple-400'
                  : 'text-[#9ca3af] hover:text-white hover:bg-[#1f2937]'
              }`}
              title={isCollapsed ? 'DNS Intelligence' : ''}
            >
              <svg className="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {!isCollapsed && <span className="font-medium text-sm">DNS Intelligence</span>}
            </Link>

            {/* Client Access Log */}
            <Link 
              href="/client-access"
              onClick={() => setMobileMenuOpen(false)}
              className={`flex items-center ${isCollapsed ? 'justify-center' : 'gap-3'} px-3 py-2.5 rounded-lg transition-all ${
                isActive('/client-access')
                  ? 'bg-emerald-500/10 text-emerald-400'
                  : 'text-[#9ca3af] hover:text-white hover:bg-[#1f2937]'
              }`}
              title={isCollapsed ? 'Client Access Log' : ''}
            >
              <svg className="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              {!isCollapsed && <span className="font-medium text-sm">Client Access Log</span>}
            </Link>

            {/* Laporan Harian AI */}
            <Link 
              href="/reports"
              onClick={() => setMobileMenuOpen(false)}
              className={`flex items-center ${isCollapsed ? 'justify-center' : 'gap-3'} px-3 py-2.5 rounded-lg transition-all ${
                isActive('/reports')
                  ? 'bg-indigo-500/10 text-indigo-400'
                  : 'text-[#9ca3af] hover:text-white hover:bg-[#1f2937]'
              }`}
              title={isCollapsed ? 'Laporan Harian AI' : ''}
            >
              <svg className="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              {!isCollapsed && <span className="font-medium text-sm">Laporan Harian AI</span>}
            </Link>
          </div>
        </nav>

        {/* Footer */}
        {!isCollapsed && (
          <div className="px-6 py-4 border-t border-[#1f2937]">
            <div className="flex items-center gap-2 text-xs">
              <div className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
              <span className="text-[#6b7280]">System Active</span>
            </div>
          </div>
        )}
      </aside>
    </>
  )
}
