    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Ambil data asal dari node 'If - not on queue'\nlet source = {};\ntry {\n  source = $('If - not on queue').item.json;\n} catch (e) {\n  try {\n    const queueItems = $('If - not on queue').all();\n    source = (queueItems[$itemIndex] && queueItems[$itemIndex].json) || queueItems[0].json || {};\n  } catch (e2) {\n    source = $json || {};\n  }\n}\n\nconst domain = (source.domain || '').toLowerCase().trim();\nconst client_ip = source.client_ip || '';\nconst ap_name = source.ap_name || '';\nconst ap_ip = source.ap_ip || '';\nconst query_type = source.query_type || '';\n\n// 1. Ambil daftar blacklist dari MongoDB\nlet blacklistItems = [];\ntry {\n  blacklistItems = $('Mongodb: Find document (dns_blacklist)').all() || [];\n} catch (e) {\n  blacklistItems = [];\n}\n\n// Fallback Blacklist (Otomatis Aktif jika MongoDB belum terisi)\nconst fallbackBlacklist = [\n  { domain: \"slot88-gacor.com\", group: \"Judi Online\", type: \"gambling\" },\n  { domain: \"judionline99.net\", group: \"Judi Online\", type: \"gambling\" },\n  { domain: \"phishing-bank-bca.xyz\", group: \"Phishing\", type: \"phishing\" },\n  { domain: \"bokep123.com\", group: \"Konten Dewasa\", type: \"adult\" },\n  { domain: \"malware-downloader.info\", group: \"Malware / Virus\", type: \"malware\" },\n  { domain: \"test-illegal-domain.com\", group: \"Uji Coba MSDA\", type: \"testing\" }\n];\n\n// Cari pencocokan domain di MongoDB\nlet blacklistDoc = blacklistItems.find(item => {\n  if (!item || !item.json) return false;\n  const bDomain = String(item.json.domain || '').toLowerCase().trim();\n  if (!bDomain) return false;\n  return domain === bDomain || domain.endsWith('.' + bDomain);\n}) || null;\n\nlet group = blacklistDoc && blacklistDoc.json ? blacklistDoc.json.group : null;\nlet type = blacklistDoc && blacklistDoc.json ? blacklistDoc.json.type : null;\n\n// Jika tidak ketemu di MongoDB, cek ke Fallback Blacklist bawaan\nif (!blacklistDoc) {\n  const fbMatch = fallbackBlacklist.find(fb => domain === fb.domain || domain.endsWith('.' + fb.domain));\n  if (fbMatch) {\n    blacklistDoc = { json: fbMatch };\n    group = fbMatch.group;\n    type = fbMatch.type;\n  }\n}\n\nconst inBlacklist = !!blacklistDoc;\n\n// Cek apakah Redis BENAR-BENAR menyimpan notifikasi (value harus 'true' / ada isinya, bukan null)\nconst redisVal = $json ? $json.value : null;\nconst alreadyNotified = (redisVal === 'true' || redisVal === true || (typeof redisVal === 'string' && redisVal.trim() !== '' && redisVal !== 'null'));\n\nreturn {\n  json: {\n    domain: source.domain,\n    client_ip,\n    ap_name,\n    ap_ip,\n    query_type,\n    inBlacklist,\n    group: group || 'Ilegal',\n    type: type || 'blacklist',\n    description: (blacklistDoc && blacklistDoc.json && blacklistDoc.json.description) || '',\n    detected: inBlacklist && !alreadyNotified,\n    detail: blacklistDoc ? blacklistDoc.json : null\n  }\n};\n"
      },
