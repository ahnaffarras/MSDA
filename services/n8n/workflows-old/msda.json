    {
      "parameters": {
        "jsCode": "let rawRedisItems = [];\ntry {\n  rawRedisItems = $('Redis Get: queue').all();\n} catch (e) {\n  rawRedisItems = [];\n}\n\nconst existingKeys = [];\nrawRedisItems.forEach(item => {\n  const json = item.json || {};\n  if (Array.isArray(json.keys)) {\n    json.keys.forEach(k => existingKeys.push(String(k)));\n  } else {\n    const keyVal = json.key || json.propertyName || json.value;\n    if (keyVal && typeof keyVal === 'string' && keyVal.trim() !== '') {\n      existingKeys.push(keyVal);\n    }\n  }\n});\n\nconst allItems = $('Split Out (per domain)').all();\nconst set_to_redis = [];\nconst forward_flow = [];\nconst timestamp = Math.floor(Date.now() / 1000);\nconst seenDomainsInBatch = new Set();\n\nallItems.forEach((item) => {\n  const data = item.json;\n  const domain = data.domain;\n\n  if (!domain) {\n    forward_flow.push({ ...data, timestamp });\n    return;\n  }\n\n  const isExistInRedis = existingKeys.some(k => k.includes(domain));\n  const isExistInBatch = seenDomainsInBatch.has(domain);\n\n  if (!isExistInRedis && !isExistInBatch) {\n    seenDomainsInBatch.add(domain);\n    const generatedKey = `queue_${domain}`;\n\n    set_to_redis.push({\n      key: generatedKey,\n      value: domain,\n      ...data,\n      timestamp: timestamp\n    });\n  } else {\n    forward_flow.push({\n      ...data,\n      timestamp: timestamp\n    });\n  }\n});\n\nconst outputItems = [];\nset_to_redis.forEach(entry => {\n  outputItems.push({\n    json: {\n      ...entry,\n      onQueue: false\n    }\n  });\n});\n\nforward_flow.forEach(entry => {\n  outputItems.push({\n    json: {\n      ...entry,\n      onQueue: true\n    }\n  });\n});\n\nreturn outputItems;"
      },
