    {
      "parameters": {
        "jsCode": "const item = $('Split Out (per domain)').item.json;\nconst domain = item.domain;\nconst client_ip = item.client_ip;\nconst ap_name = item.ap_name;\nconst ap_ip = item.ap_ip;\nconst query_type = item.query_type;\n\nconst blacklistItems = $('Mongodb: Find document (dns_blacklist)').all();\nconst inBlacklist = blacklistItems.length > 0 && blacklistItems[0].json && blacklistItems[0].json._id;\nconst blacklistDoc = inBlacklist ? blacklistItems[0].json : null;\n\nconst alreadyNotified = $input.first().json.propertyName !== undefined && $input.first().json.propertyName !== null;\n\nreturn [{\n  json: {\n    domain,\n    client_ip,\n    ap_name,\n    ap_ip,\n    query_type,\n    group: blacklistDoc ? blacklistDoc.group : null,\n    type: blacklistDoc ? blacklistDoc.type : null,\n    detected: !!inBlacklist && !alreadyNotified,\n    detail: blacklistDoc\n  }\n}];"
      },
