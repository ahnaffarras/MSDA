      "parameters": {
        "jsCode": "// domain sudah pernah masuk antrian atau belum\nconst redisValue = $input.first().json.propertyName ?? null;\nconst domain = $('Split Out (per domain)').item.json.domain;\nconst timestamp = $('Split Out (per domain)').item.json.timestamp;\n\nreturn [{ json: { domain, timestamp, onQueue: redisValue !== null && redisValue !== undefined } }];"
