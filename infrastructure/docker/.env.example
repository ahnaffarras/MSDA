# ============================================================
# SATA — Environment Configuration
# Salin file ini menjadi .env dan isi nilainya sebelum
# menjalankan: docker compose up -d
# ============================================================

# ------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------
MONGO_ROOT_USER=sata
MONGO_ROOT_PASSWORD=sata123

# ------------------------------------------------------------
# n8n
# ------------------------------------------------------------
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=change-me-to-a-random-32-char-string
N8N_WEBHOOK_URL=http://localhost:5678/

# ------------------------------------------------------------
# SATA Webhook Security
# Token ini harus sama persis antara Vector (pengirim)
# dan n8n (penerima). Ganti dengan string acak yang kuat.
# ------------------------------------------------------------
SATA_WEBHOOK_TOKEN=changeme-token

# ------------------------------------------------------------
# Google AI Studio (Gemini)
# Dapatkan API key di: https://aistudio.google.com/app/apikey
# Digunakan oleh workflow sata-daily-report untuk generate
# ringkasan laporan harian.
# ------------------------------------------------------------
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# ------------------------------------------------------------
# Slack Incoming Webhook URL
# Buat di: https://api.slack.com/apps → Incoming Webhooks
# Satu URL dipakai untuk semua alert (flag, anomaly, laporan)
# ------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
