# ============================================================
# MSDA — Environment Configuration
# Salin file ini menjadi .env dan isi nilainya sebelum
# menjalankan: docker compose up -d
# ============================================================

# ------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------
# WAJIB. Buat dengan:  openssl rand -hex 16
# Pakai karakter huruf/angka saja (hex) agar aman di dalam URI koneksi.
# Catatan: password hanya dipakai saat volume MongoDB pertama kali dibuat. Mengubahnya
# pada volume yang sudah ada TIDAK mengganti password user di database.
MONGO_ROOT_USER=msda
MONGO_ROOT_PASSWORD=

# ------------------------------------------------------------
# n8n
# ------------------------------------------------------------
N8N_HOST=localhost
# WAJIB. openssl rand -hex 16. Bila n8n sudah menyimpan kredensial, PAKAI NILAI YANG SAMA
# seperti sebelumnya (kunci baru membuat kredensial lama tidak bisa dibaca).
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/

# ------------------------------------------------------------
# Secret bersama (WAJIB, keduanya harus berbeda)
# Buat tiap nilai dengan:  openssl rand -hex 32
#
# MSDA_WEBHOOK_TOKEN  : header X-MSDA-Token. Dikirim Vector ke n8n dan dari n8n ke
#                       POST /api/v1/webhooks/n8n di backend.
# MSDA_INTERNAL_TOKEN : header X-Internal-Token. Hanya dikenal dashboard dan backend;
#                       tanpa ini semua endpoint backend (selain webhook & health) ditolak.
#
# Dengan APP_ENV=production backend menolak start bila token kosong, <32 karakter,
# atau masih berisi nilai contoh.
# ------------------------------------------------------------
MSDA_WEBHOOK_TOKEN=
MSDA_INTERNAL_TOKEN=

# ------------------------------------------------------------
# Tombol "Send test" di Notifications > Settings (opsional)
# URL webhook n8n yang menerima { channel, message, requested_by }.
# Workflow-nya dibuat di sisi n8n. Kosong = tombol dinonaktifkan.
# ------------------------------------------------------------
N8N_TEST_NOTIFY_URL=

# ------------------------------------------------------------
# Privasi klien (opsional)
# Kunci rahasia untuk menyamarkan IP klien dari peran viewer (Users & Access → Client privacy).
# Kosong = memakai MSDA_INTERNAL_TOKEN. Mengubahnya mengganti tag samaran yang tampil.
# ------------------------------------------------------------
MSDA_PRIVACY_KEY=

# ------------------------------------------------------------
# Google AI Studio (Gemini)
# Dapatkan API key di: https://aistudio.google.com/app/apikey
# Digunakan oleh workflow msda-daily-report untuk generate
# ringkasan laporan harian.
# ------------------------------------------------------------
GOOGLE_AI_API_KEY=isi-api-key-google-ai-studio

# ------------------------------------------------------------
# Slack Incoming Webhook URL
# Buat di: https://api.slack.com/apps → Incoming Webhooks
# Satu URL dipakai untuk semua alert (flag, anomaly, laporan)
# ------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ------------------------------------------------------------
# Login dashboard
# Akun administrator pertama dibuat otomatis saat dashboard start
# dan belum ada pengguna sama sekali. Setelah itu, tambah / ubah /
# nonaktifkan pengguna lewat menu "Users & Access" di dashboard.
#
# - PASSWORD kosong  -> dibuat kata sandi acak, dicetak SEKALI di:
#                       docker logs msda-dashboard
# - PASSWORD diisi   -> minimal 10 karakter (kalau lebih lemah, ditolak
#                       dan diganti kata sandi acak)
# Nilai ini hanya dipakai sekali. Mengubahnya setelah akun ada TIDAK
# mengganti kata sandi; pakai menu "Reset password".
# ------------------------------------------------------------
MSDA_BOOTSTRAP_ADMIN_USER=admin
MSDA_BOOTSTRAP_ADMIN_PASSWORD=

# Lama sesi login (jam). Setelah itu pengguna harus login lagi.
MSDA_SESSION_HOURS=12

# Biarkan kosong: cookie otomatis "Secure" bila diakses lewat HTTPS.
# Isi true bila TLS dihentikan di proxy yang tidak mengirim
# X-Forwarded-Proto; isi false hanya untuk akses HTTP di jaringan lokal.
MSDA_COOKIE_SECURE=

# Hanya bila dashboard di belakang reverse proxy yang mengubah header Host
# dan permintaan tulis ditolak ("Cross-site request blocked").
# Contoh: dashboard.sekolah.sch.id,msda.local
MSDA_ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Backup MongoDB terjadwal (service `backup`)
# Salinan disimpan di volume Docker `backup-data` pada host yang sama.
# Salin ke tempat lain secara berkala (lihat docs/backup-restore.md).
# ------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
