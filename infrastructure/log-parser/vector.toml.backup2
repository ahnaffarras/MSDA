data_dir = "/var/lib/vector"

# =============================================================
# SATA - Vector.dev Config (Raw UDP Socket Mode)
# Menerima raw syslog dari Mikrotik RouterOS via UDP Port 514,
# parsing ke JSON, batching, lalu POST ke webhook n8n.
# =============================================================

[sources.mikrotik_raw]
type = "socket"
address = "0.0.0.0:514"
mode = "udp"
framing.method = "newline_delimited"
decoding.codec = "bytes"

# --- Transform: parsing raw UDP message dari Mikrotik RouterOS ---
[transforms.parse_dns]
type = "remap"
inputs = ["mikrotik_raw"]
source = '''
raw = string(.message) ?? ""

.ap_ip = string(.host) ?? "unknown"
.ap_name = string(.host) ?? "unknown"

# Pola 1: Standard DNS query ("dns query from 192.168.10.45: #57 youtube.com. A")
dns_parts, err = parse_regex(raw, r'query from (?P<client_ip>\d{1,3}(\.\d{1,3}){3}):?\d*:\s*#?\d*\s*(?P<domain>[a-zA-Z0-9\-\.\_]+)')
if err == null {
    .client_ip = dns_parts.client_ip
    # Gantikan trailing dot menggunakan replace regex
    .domain = replace(string(dns_parts.domain) ?? "", r'\.$', "")
} else {
    # Pola 2: Format DNS packet question ("dns,packet question: s.youtube.com:A:IN")
    dns_parts2, err2 = parse_regex(raw, r'dns,packet question:\s*(?P<domain>[a-zA-Z0-9\-\.\_]+):[A-Z]+:[A-Z]+')
    if err2 == null {
        .client_ip = string(.host) ?? "unknown"
        .domain = replace(string(dns_parts2.domain) ?? "", r'\.$', "")
    } else {
        # Pola 3: Format alternatif ("query[A] youtube.com from 192.168.10.45")
        dns_parts3, err3 = parse_regex(raw, r'query\[[A-Z]+\]\s+(?P<domain>[a-zA-Z0-9\-\.\_]+)\s+from\s+(?P<client_ip>\d{1,3}(\.\d{1,3}){3})')
        if err3 == null {
            .client_ip = dns_parts3.client_ip
            .domain = replace(string(dns_parts3.domain) ?? "", r'\.$', "")
        } else {
            .parse_error = true
            .domain = null
            .client_ip = null
        }
    }
}

# Bersihkan field ekstra yang tidak ada dalam skema spesifikasi SATA
del(.host)
del(.port)
del(.parse_error)
del(.message)

.timestamp = now()
.source_type = "mikrotik_dns"
'''

# Buang event yang tidak memuat domain dan client_ip valid
[transforms.filter_valid]
type = "filter"
inputs = ["parse_dns"]
condition = '.domain != null && .client_ip != null'

# --- Sink: kirim batch ke n8n webhook ---
[sinks.n8n_webhook]
type = "http"
inputs = ["filter_valid"]
uri = "${VECTOR_N8N_WEBHOOK_URL:-http://n8n:5678/webhook/dns-scan-webhook}"
method = "post"
encoding.codec = "json"
compression = "none"

batch.max_events = 100
batch.timeout_secs = 10

request.headers.Content-Type = "application/json"
request.headers.X-SATA-Token = "${SATA_WEBHOOK_TOKEN:-changeme-token}"

request.retry_attempts = 10
request.retry_initial_backoff_secs = 5
request.retry_max_duration_secs = 3600

# --- Console Log untuk Debugging (Event VALID yang sesuai Schema) ---
[sinks.debug_console]
type = "console"
inputs = ["filter_valid"]
encoding.codec = "json"
